#!/usr/bin/env python3
"""keytap-collector — global keypress capture for the Keytap omarchy plugin.

Reads every keyboard-ish evdev device under /dev/input/event* (requires the
`input` group, not root), tracks modifier state across devices, and emits the
current combo as one JSON object per line on stdout:

    {"seq": 1, "combo": ["Ctrl", "Shift", "T"]}

An empty combo array means "all keys released" — the UI should hide.
"""

import json
import os
import re
import select
import signal
import sys
import time

from evdev import InputDevice, ecodes, list_devices

RESCAN_SECONDS = 3.0

# Canonical display order for modifiers.
MOD_ORDER = ["Ctrl", "Super", "Alt", "AltGr", "Shift"]

MOD_LABELS = {
    ecodes.KEY_LEFTCTRL: "Ctrl",
    ecodes.KEY_RIGHTCTRL: "Ctrl",
    ecodes.KEY_LEFTMETA: "Super",
    ecodes.KEY_RIGHTMETA: "Super",
    ecodes.KEY_LEFTALT: "Alt",
    ecodes.KEY_RIGHTALT: "AltGr",
    ecodes.KEY_LEFTSHIFT: "Shift",
    ecodes.KEY_RIGHTSHIFT: "Shift",
}


def _code(name):
    return getattr(ecodes, name, None)


def build_labels():
    labels = {}

    # Letter codes are NOT contiguous (three interleaved QWERTY rows:
    # A=30 S=31 D=32 ... Z=44), so resolve each by name.
    for ch in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
        code = _code("KEY_" + ch)
        if code is not None:
            labels[code] = ch

    for i in range(ecodes.KEY_1, ecodes.KEY_0 + 1):
        labels[i] = str(i - ecodes.KEY_1 + 1) if i != ecodes.KEY_0 else "0"

    for i in range(1, 25):
        code = _code("KEY_F%d" % i)
        if code is not None:
            labels[code] = "F%d" % i

    named = {
        "KEY_ESC": "Esc", "KEY_ENTER": "Enter", "KEY_SPACE": "Space",
        "KEY_TAB": "Tab", "KEY_BACKSPACE": "Backspace", "KEY_DELETE": "Del",
        "KEY_INSERT": "Ins", "KEY_HOME": "Home", "KEY_END": "End",
        "KEY_PAGEUP": "PgUp", "KEY_PAGEDOWN": "PgDn",
        "KEY_PRINT": "PrtSc", "KEY_SYSRQ": "SysRq", "KEY_PAUSE": "Pause",
        "KEY_SCROLLLOCK": "ScrLk", "KEY_CAPSLOCK": "Caps",
        "KEY_NUMLOCK": "Num", "KEY_KPENTER": "NumEnter",
        "KEY_UP": "\u2191", "KEY_DOWN": "\u2193",
        "KEY_LEFT": "\u2190", "KEY_RIGHT": "\u2192",
        "KEY_GRAVE": "`", "KEY_MINUS": "-", "KEY_EQUAL": "=",
        "KEY_LEFTBRACE": "[", "KEY_RIGHTBRACE": "]",
        "KEY_BACKSLASH": "\\", "KEY_SEMICOLON": ";", "KEY_APOSTROPHE": "'",
        "KEY_COMMA": ",", "KEY_DOT": ".", "KEY_SLASH": "/",
        "KEY_KPSLASH": "Num/", "KEY_KPASTERISK": "Num*",
        "KEY_KPMINUS": "Num-", "KEY_KPPLUS": "Num+", "KEY_KPDOT": "Num.",
        "KEY_KPEQUAL": "Num=", "KEY_KPCOMMA": "Num,",
        "KEY_HENKAN": "Henkan", "KEY_MUHENKAN": "Muhenkan",
        "KEY_ZENKAKUHANKAKU": "Zenkaku", "KEY_YEN": "\u00a5",
        "KEY_RO": "\\", "KEY_KATAKANA": "Katakana", "KEY_HIRAGANA": "Hiragana",
    }
    for i in range(1, 10):
        named["KEY_KP%d" % i] = "Num%d" % i
    for name, label in named.items():
        code = _code(name)
        if code is not None:
            labels[code] = label

    media = {
        "KEY_VOLUMEUP": "Vol+", "KEY_VOLUMEDOWN": "Vol-", "KEY_MUTE": "Mute",
        "KEY_PLAYPAUSE": "Play", "KEY_STOPCD": "Stop", "KEY_EJECTCD": "Eject",
        "KEY_NEXTSONG": "Next", "KEY_PREVSONG": "Prev",
        "KEY_BRIGHTNESSUP": "Bri+", "KEY_BRIGHTNESSDOWN": "Bri-",
        "KEY_MICMUTE": "MicMute", "KEY_POWER": "Power", "KEY_SLEEP": "Sleep",
        "KEY_CALC": "Calc", "KEY_EMAIL": "Mail", "KEY_HOMEPAGE": "Home",
        "KEY_SEARCH": "Search", "KEY_REFRESH": "Refresh",
        "KEY_FIND": "Find", "KEY_WWW": "WWW",
    }
    for name, label in media.items():
        code = _code(name)
        if code is not None:
            labels[code] = label

    return labels


LABELS = build_labels()

# Optional: only capture devices whose name matches this regex, e.g.
# KEYTAP_DEVICE_FILTER=".*HHKB.*" to ignore other keyboards.
DEVICE_FILTER = None
_filter_value = os.environ.get("KEYTAP_DEVICE_FILTER", "").strip()
if _filter_value:
    try:
        DEVICE_FILTER = re.compile(_filter_value)
    except re.error:
        pass


def is_keyboard(device):
    if DEVICE_FILTER is not None:
        return bool(DEVICE_FILTER.search(device.name or ""))
    try:
        key_caps = set(device.capabilities(verbose=False).get(ecodes.EV_KEY, []))
    except Exception:
        return False
    sentinels = [
        ecodes.KEY_A, ecodes.KEY_VOLUMEUP, ecodes.KEY_PLAYPAUSE,
        getattr(ecodes, "KEY_POWER", None),
    ]
    return any(s is not None and s in key_caps for s in sentinels)


class Collector:
    def __init__(self):
        self.devices = {}          # path -> InputDevice
        self.pressed_by_dev = {}   # path -> set of down codes
        self.press_order = []      # non-modifier codes in press order
        self.seq = 0

    def scan(self):
        seen = set()
        for path in list_devices():
            seen.add(path)
            if path in self.devices:
                continue
            try:
                device = InputDevice(path)
            except Exception:
                continue
            if not is_keyboard(device):
                device.close()
                continue
            self.devices[path] = device
            self.pressed_by_dev.setdefault(path, set())

        # Drop devices that vanished; clear their held keys so combos don't stick.
        dead = [p for p in self.devices if p not in seen]
        for path in dead:
            self.remove(path)

    def remove(self, path):
        device = self.devices.pop(path, None)
        pressed = self.pressed_by_dev.pop(path, None)
        changed = bool(pressed)
        if pressed:
            for code in pressed:
                self.press_order[:] = [c for c in self.press_order if c != code]
        if device:
            try:
                device.close()
            except Exception:
                pass
        return changed

    def all_down(self):
        down = set()
        for pressed in self.pressed_by_dev.values():
            down |= pressed
        return down

    def emit(self):
        down = self.all_down()
        mod_labels = [MOD_LABELS[c] for c in down if c in MOD_LABELS]
        ordered_mods = [m for m in MOD_ORDER if m in mod_labels]
        ordered_mods += [m for m in mod_labels if m not in MOD_ORDER]
        keys = [LABELS[c] for c in self.press_order if c in LABELS]
        self.seq += 1
        payload = json.dumps(
            {"seq": self.seq, "combo": ordered_mods + keys}, ensure_ascii=False
        )
        sys.stdout.write(payload + "\n")
        sys.stdout.flush()

    def handle_event(self, path, event):
        if event.type != ecodes.EV_KEY or event.value not in (0, 1):
            return  # ignore autorepeat (2) and non-key events
        code = event.code
        if os.environ.get("KEYTAP_DEBUG"):
            sys.stderr.write("event %s type=%d code=%d value=%d\n" % (path, event.type, code, event.value))
            sys.stderr.flush()
        pressed = self.pressed_by_dev[path]
        if event.value == 1:
            if code in pressed:
                return
            pressed.add(code)
            if code not in MOD_LABELS:
                if code in self.press_order:
                    self.press_order.remove(code)
                self.press_order.append(code)
        else:
            if code not in pressed:
                return
            pressed.discard(code)
            if code not in MOD_LABELS and code in self.press_order:
                self.press_order.remove(code)
        self.emit()

    def run(self):
        self.scan()
        self.emit()
        last_scan = time.monotonic()
        while True:
            fds = [d.fd for d in self.devices.values()]
            ready, _, _ = select.select(fds, [], [], RESCAN_SECONDS)
            rescan_needed = False
            for fd in ready:
                path = next((p for p, d in self.devices.items() if d.fd == fd), None)
                if path is None:
                    continue
                device = self.devices[path]
                try:
                    for event in device.read():
                        self.handle_event(path, event)
                except (OSError, EOFError):
                    if self.remove(path):
                        self.emit()
                    rescan_needed = True
            # Rescan on idle timeout OR whenever the interval elapsed — a
            # busy select loop must not starve hotplug discovery.
            now = time.monotonic()
            if rescan_needed or not ready or now - last_scan >= RESCAN_SECONDS:
                last_scan = now
                self.scan()


def main():
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        Collector().run()
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
